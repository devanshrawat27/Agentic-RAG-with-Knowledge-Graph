# ---------------------------------------------------------------------------
# Backend configuration
# Copy to .env and fill in real values. Everything here is a placeholder.
# ---------------------------------------------------------------------------

# --- LLM ---
# Google Gemini API key (primary LLM). Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.0-flash is retired; gemini-flash-latest tracks the current flash.
GEMINI_MODEL=gemini-flash-latest
# "gemini" | "ollama"
LLM_PROVIDER=gemini
# Fail fast on 429/quota rather than retrying for minutes.
LLM_MAX_RETRIES=1

# Ollama fallback (local, zero cost). Leave empty to disable fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
# Gemini embedding (primary). text-embedding-004 is retired.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=3072
# Hugging Face fallback model
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (Qdrant) ---
# Local: point to the docker-compose Qdrant service.
QDRANT_URL=http://localhost:6333
# Qdrant Cloud: set the cluster URL + API key (leave empty for local).
QDRANT_API_KEY=

# --- Graph database (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Relational database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentic_rag
# Optional single connection string. LEAVE EMPTY for Docker/local — if set it
# OVERRIDES the individual POSTGRES_* fields above (and would ignore the
# `postgres` service host in docker-compose).
DATABASE_URL=

# --- Backend app ---
APP_HOST=0.0.0.0
APP_PORT=8000
# Base URL of the frontend, used to build email links (verify / reset).
FRONTEND_BASE_URL=http://localhost:3000

# --- Auth (per-user isolation) ---
# CHANGE THIS to a long random string in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token

# --- Email (verification / password reset) ---
# Leave SMTP_HOST empty to use DEV MODE: links are logged to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agentic-rag.local

# ---------------------------------------------------------------------------
# Frontend configuration (read by Next.js)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
