# ---------------------------------------------------------------------------
# Backend configuration
# Copy to .env and fill in real values. Everything here is a placeholder.
# ---------------------------------------------------------------------------

# --- LLM ---
# Google Gemini API key (primary LLM). Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama fallback (local, zero cost). Leave empty to disable fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- Embeddings ---
# Gemini text-embedding-004 (primary)
EMBEDDING_PROVIDER=gemini
# Hugging Face fallback model
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (ChromaDB, embedded) ---
CHROMA_PERSIST_DIR=./chroma

# --- Graph database (Neo4j) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Relational database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=agentic_rag
# Full connection string (if you prefer one field):
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/agentic_rag

# --- Backend app ---
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Auth (per-user isolation) ---
# CHANGE THIS to a long random string in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_NAME=access_token

# --- Email (verification / password reset) ---
# Leave SMTP_HOST empty to use DEV MODE: links are logged to the backend console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@agentic-rag.local

# ---------------------------------------------------------------------------
# Frontend configuration
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
